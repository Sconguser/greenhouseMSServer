# ─────────────────────────────────────────────────────────────────────────────
# Greenhouse server — environment variables
# Copy this file to .env and fill in every value marked CHANGE_ME.
# .env is gitignored; never commit the real file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Compose ────────────────────────────────────────────────────────────
# Prefix used for container names (e.g. greenhouse-db, greenhouse-app)
COMPOSE_PROJECT_NAME=greenhouse

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_TAG=16-alpine
POSTGRES_DB=greenhouse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ── Spring / JPA ─────────────────────────────────────────────────────────────
# "update" creates/alters tables automatically on first run — fine for dev/friends.
# Use "validate" in production.
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret used to sign and verify every JWT token.
# Must be the SAME value on every instance; changing it invalidates all sessions.
# Use any random string ≥ 32 characters (e.g. from https://1password.com/password-generator/)
JWT_SECRET_KEY=CHANGE_ME_use_a_long_random_string_at_least_32_chars
# Token lifetime in milliseconds. 86400000 = 24 hours.
JWT_EXPIRATION_TIME=86400000

# ── MQTT (Mosquitto) ──────────────────────────────────────────────────────────
# Points to the 'mqtt' service defined in docker-compose.yml.
# Change only if you run an external broker.
MQTT_BROKER=tcp://mqtt:1883
MQTT_CLIENT_ID=spring-server
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Exposed port ──────────────────────────────────────────────────────────────
# Port the Spring Boot server listens on (from the host's perspective).
# The Flutter app must be configured to reach http://<your-ip>:APP_PORT
APP_PORT=8080

# ── JVM tuning (optional) ─────────────────────────────────────────────────────
JAVA_OPTS=