    {
      "name": "Parameter",
      "item": [
        {
          "name": "Update parameters (triggers MQTT model push)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": 1,\n    \"requestedValue\": 25.0\n  },\n  {\n    \"id\": 2,\n    \"requestedValue\": 1.0\n  }\n]",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/parameter/updateParameters",
              "host": ["{{baseUrl}}"],
              "path": ["parameter", "updateParameters"]
            },
            "description": "Update `requestedValue` for one or more parameters. After saving to DB, the server automatically pushes the **full** greenhouse model to the device over MQTT (`greenhouse/<ip>/set/model`).\n\nOnly `id` and `requestedValue` are required per item. Other fields in the body are ignored.\n\nIf you have MQTTX subscribed to `greenhouse/+/set/model`, you will see the push arrive within milliseconds."
          },
          "response": []
        },
        {
          "name": "Delete parameter",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/parameter/:id",
              "host": ["{{baseUrl}}"],
              "path": ["parameter", ":id"],
              "variable": [{ "key": "id", "value": "{{parameterId}}" }]
            }
          },
          "response": []
        }
      ]
    },

