    {
      "name": "Notifications",
      "item": [
        {
          "name": "Set FCM token for user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fcmToken\": \"AAAAxxxxx:APA91bHPRgkFLkB...\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/notifications/:userId",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", ":userId"],
              "variable": [{ "key": "userId", "value": "{{userId}}" }]
            },
            "description": "Register a Firebase Cloud Messaging token so the user receives push notifications when sensor values go out of range."
          },
          "response": []
