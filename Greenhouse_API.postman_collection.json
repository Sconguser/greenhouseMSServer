            "url": {
              "raw": "{{baseUrl}}/zone/:id/addFlowerpot",
              "host": ["{{baseUrl}}"],
              "path": ["zone", ":id", "addFlowerpot"],
              "variable": [{ "key": "id", "value": "{{zoneId}}" }]
            }
          },
          "response": []
        },
        {
          "name": "Get all flowerpots in zone",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/zone/:id/flowerpots",
              "host": ["{{baseUrl}}"],
              "path": ["zone", ":id", "flowerpots"],
              "variable": [{ "key": "id", "value": "{{zoneId}}" }]
            }
          },
          "response": []
        },
        {
          "name": "Get flowerpot by ID (in zone)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/zone/:zoneId/flowerpots/:flowerpotId",
              "host": ["{{baseUrl}}"],
              "path": ["zone", ":zoneId", "flowerpots", ":flowerpotId"],
              "variable": [
                { "key": "zoneId",      "value": "{{zoneId}}" },
                { "key": "flowerpotId", "value": "{{flowerpotId}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete flowerpot from zone",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/zone/:zoneId/deleteFlowerpot/:flowerpotId",
              "host": ["{{baseUrl}}"],
              "path": ["zone", ":zoneId", "deleteFlowerpot", ":flowerpotId"],
              "variable": [
                { "key": "zoneId",      "value": "{{zoneId}}" },
                { "key": "flowerpotId", "value": "{{flowerpotId}}" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add parameter to zone",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Temperature\",\n  \"mutable\": true,\n  \"currentValue\": 22.5,\n  \"requestedValue\": 25.0,\n  \"min\": 15.0,\n  \"max\": 35.0,\n  \"unit\": \"C\",\n  \"parameterType\": \"Value\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/zone/:id/addParameter",
              "host": ["{{baseUrl}}"],
              "path": ["zone", ":id", "addParameter"],
              "variable": [{ "key": "id", "value": "{{zoneId}}" }]
            },
            "description": "Add a parameter to a zone.\n\n`parameterType`: `VALUE` (numeric sensor reading) or `TOGGLE` (on/off actuator)\n`mutable`: `true` means the Arduino can receive a `requestedValue` and act on it"
          },
          "response": []
        },
        {
          "name": "Add TOGGLE parameter to zone",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HeaterSwitch\",\n  \"mutable\": true,\n  \"currentValue\": 0.0,\n  \"requestedValue\": 1.0,\n  \"min\": 0.0,\n  \"max\": 1.0,\n  \"unit\": \"\",\n  \"parameterType\": \"Toggle\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/zone/:id/addParameter",
              "host": ["{{baseUrl}}"],
              "path": ["zone", ":id", "addParameter"],
              "variable": [{ "key": "id", "value": "{{zoneId}}" }]
            },
            "description": "TOGGLE type — the Arduino reads this with `parameterType.equalsIgnoreCase(\"TOGGLE\")`. `requestedValue` of 1.0 = ON, 0.0 = OFF."
          },
          "response": []
        },
        {
          "name": "Get zone parameters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/zone/:id/parameters",
              "host": ["{{baseUrl}}"],
              "path": ["zone", ":id", "parameters"],
              "variable": [{ "key": "id", "value": "{{zoneId}}" }]
            }
          },
          "response": []
        }
      ]
    },

